+static inline int rr_role_category(const char* role) {
+    if (!role) return RR_ROLE_UNKNOWN;
+    if (!strcmp(role, "cop") || !strcmp(role, "police")) return RR_ROLE_COP;
+    if (!strcmp(role, "robber") || !strcmp(role, "bandit") || !strcmp(role, "criminal")) return RR_ROLE_ROBBER;
