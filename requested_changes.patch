+/* CharacterOwner identifies the owner, independently of ControlOwner/seats.
+ * The public ID is direct primitive data, not a PrimitiveModel wrapper. */
+static int vehicle_owner_id(uint64_t object, int kind, int64_t* out) {
+    if (!out) return 0;
+    *out = 0;
+    if (kind < 0 || kind > 1 || !u_is(object, kind ? "HelicopterModel" : "CarModel")) return 0;
+    unsigned offset = kind ? RR_OFF_HELI_CHARACTER_OWNER : RR_OFF_CAR_CHARACTER_OWNER;
+    uint64_t model = rr_u64(object + offset);
+    if (!u_is(model, "VehicleOwnerModel")) return 0;
+    uint64_t data = rr_u64(model + RR_OFF_VEHICLE_OWNER_PUBLIC);
+    int64_t id, empty;
+    if (!PL(data) || !PL(rr_u64(data)) ||
+        !rr_read(data + RR_OFF_PRIM_VALUE, &id, sizeof(id)) ||
+        !rr_read(model + RR_OFF_VEHICLE_OWNER_EMPTY, &empty, sizeof(empty)) ||
+        rr_u64(object + offset) != model || rr_u64(model + RR_OFF_VEHICLE_OWNER_PUBLIC) != data) return 0;
+    if (id != empty && id <= 0) return 0;
+    *out = id == empty ? 0 : id;
+    return 1;
+}
