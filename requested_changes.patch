+/* Resolve all owners once per vehicle scan. Slots can name owners whose
+ * character model is outside the current ESP roster. No private IDs are read. */
+static void cache_vehicle_owner_names(VEH_CACHE* vehicles, int count) {
+    uint64_t world = g_world, battle = g_battle;
