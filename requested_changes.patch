+/* Resolve only straight-line int-returning price delegates. This reads values;
+ * it never invokes callbacks, executes target code or writes to the game.
+ * Complex callbacks remain unavailable rather than guessing a sale formula. */
+static int loot_delegate_price(uint64_t function, int* out) {
+    if(!out || !u_is(function,"Func`1") || !PL(g_module))return 0;
+    uint64_t method=rr_u64(function+0x10), target=rr_u64(function+0x20);
+    for(int hop=0;hop<4;++hop) {
+        if(method<g_module || method-g_module>RR_PRICING_IMAGE_SIZE-16)return 0;
+        uint8_t code[16];if(!rr_read(method,code,sizeof(code)))return 0;
+        if(code[0]==0xE9) {int32_t relative;memcpy(&relative,code+1,4);method+=5+(int64_t)relative;continue;}
+        if(code[0]==0xEB) {method+=2+(int8_t)code[1];continue;}
+        const uint8_t* instruction=code;
+        if(!memcmp(code,"\xF3\x0F\x1E\xFA",4))instruction+=4;
+        int32_t value;
+        if(instruction[0]==0xB8 && instruction[5]==0xC3)memcpy(&value,instruction+1,4);
+        else if((instruction[0]==0x33 || instruction[0]==0x31) && instruction[1]==0xC0 && instruction[2]==0xC3)value=0;
+        else {
+            int32_t offset=-1;
+            if(instruction[0]==0x8B && instruction[1]==0x41 && instruction[3]==0xC3)offset=(int8_t)instruction[2];
+            else if(instruction[0]==0x8B && instruction[1]==0x81 && instruction[6]==0xC3)memcpy(&offset,instruction+2,4);
+            if(offset<0x10 || offset>0x1000 || !PL(target) || !PL(rr_u64(target)) ||
+               !rr_read(target+(uint64_t)offset,&value,sizeof(value)))return 0;
+        }
+        if(value<0)return 0;
+        *out=value;return 1;
+    }
+    return 0;
+}
+static void loot_read_prices(uint64_t inventory, int* base, int* npc, unsigned* flags) {
+    *base=*npc=0;*flags=0;
+    if(!u_is(inventory,"InventoryItemDescription"))return;
+    if(loot_delegate_price(rr_u64(inventory+RR_OFF_ITEM_BASE_PRICE_FUNC),base))*flags|=RR_LOOT_PRICE_BASE;
+    uint8_t can_sell=0;
+    if(rr_read(inventory+RR_OFF_ITEM_CAN_SELL,&can_sell,1) && can_sell==1 &&
+       loot_delegate_price(rr_u64(inventory+RR_OFF_ITEM_SELL_PRICE_FUNC),npc))*flags|=RR_LOOT_PRICE_NPC;
+}
 
