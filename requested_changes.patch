+    if (!strcmp(role,"prisoner") || !strcmp(role,"inmate") || !strcmp(role,"convict")) return RR_ROLE_PRISONER;
+    if (!strcmp(role,"npc") || !strcmp(role,"bot")) return RR_ROLE_NPC;
+    return RR_ROLE_UNKNOWN;
+}
+
+static inline int rr_category_allowed(const char* role, int cops, int robbers, int civilians, int prisoners, int npcs) {
+    switch (rr_role_category(role)) {
+        case RR_ROLE_COP: return cops;
+        case RR_ROLE_ROBBER: return robbers;
+        case RR_ROLE_CIVILIAN: return civilians;
+        case RR_ROLE_PRISONER: return prisoners;
+        case RR_ROLE_NPC: return npcs;
+        default: return 1;
+    }
+}
 
