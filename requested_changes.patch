+        for (int j = 0; j < g_ncache; ++j) {
+            if (g_cache[j].public_id != v->owner_public_id) continue;
+            if (g_cache[j].local) snprintf(v->owner_name, sizeof(v->owner_name), "YOU");
+            else snprintf(v->owner_name, sizeof(v->owner_name), "%s", g_cache[j].name);
+            break;
+        }
+        pending |= !v->owner_name[0];
+    }
+    if (g_cs_ready) LeaveCriticalSection(&g_cache_cs);
+    if (!pending || !PL(world) || !u_is(battle, "BattleEntitiesModel") ||
+        rr_u64(battle + RR_OFF_BATTLE_WORLD) != world) return;
+    uint64_t slots = rr_u64(battle + RR_OFF_BATTLE_SLOTS);
+    uint64_t dict = PL(slots) ? rr_u64(slots + 0x18) : 0, entries = 0;
+    int n = 0, stride = 0;
+    if (!u_dict(dict, &n, &entries, &stride) || n < 0 || n > 4096 || stride != 0x18) return;
+    for (int i = 0; i < n; ++i) {
+        uint8_t row[0x18]; int32_t hash, key, id; uint64_t slot;
+        if (!rr_read(entries + (uint64_t)i * 0x18, row, sizeof(row))) break;
+        memcpy(&hash, row, 4); memcpy(&key, row + 8, 4); memcpy(&slot, row + 0x10, 8);
+        if (hash < 0 || !PL(slot)) continue;
+        uint64_t data = rr_u64(slot + RR_OFF_SLOT_DATA);
+        if (!u_is(data, "BattleCharacterSlotData")) continue;
+        uint64_t entity_data = rr_u64(data + RR_OFF_SLOT_ENTITY_ID);
+        if (!PL(entity_data) || !rr_read(entity_data + RR_OFF_PRIM_VALUE, &id, sizeof(id)) || id != key) continue;
+        uint64_t public_data = rr_u64(data + RR_OFF_SLOT_PUBLIC_ID);
+        int64_t public_id = 0;
+        if (!PL(public_data) || !PL(rr_u64(public_data)) ||
+            !rr_read(public_data + RR_OFF_PRIM_VALUE, &public_id, sizeof(public_id)) || public_id <= 0) continue;
+        char name[RR_NAME_MAX] = {0};
+        int needed = 0;
+        for (int j = 0; j < count; ++j)
+            needed |= vehicles[j].owner_known && vehicles[j].owner_public_id == public_id && !vehicles[j].owner_name[0];
+        if (!needed) continue;
+        uint64_t nickname = rr_u64(data + RR_OFF_SLOT_NICKNAME);
+        if (!PL(nickname) || !u_string(rr_u64(nickname + RR_OFF_REF_VALUE), name, sizeof(name)) || !name[0]) continue;
+        if (world != g_world || battle != g_battle || rr_u64(battle + RR_OFF_BATTLE_WORLD) != world) break;
+        for (int j = 0; j < count; ++j)
+            if (vehicles[j].owner_known && vehicles[j].owner_public_id == public_id && !vehicles[j].owner_name[0])
+                snprintf(vehicles[j].owner_name, sizeof(vehicles[j].owner_name), "%s", name);
+    }
+}
