+/* Read local-only weapon spread. +0x18 on BattleCharacterModel is Events,
+ * so resolve the client through BattleEntitiesModel.Player instead. */
+static void snapshot_read_spread(uint64_t character, RR_PLAYER* out) {
+    if (!out) return;
+    out->has_spread_data = out->has_fake_spread_data = 0;
+    out->spread_value = out->spread_move = out->spread_air = 0.0f;
+    if (!PL(character) || rr_u64(character) != g_k_char) return;
+    uint64_t priv = rr_u64(character + RR_OFF_CHAR_PRIVATE);
+    if (u_is(priv, "BattleCharacterPrivateModel")) {
+        uint64_t model = rr_u64(priv + RR_OFF_PRIV_WEAPON_SPREAD);
+        uint64_t data = u_is(model, "PrimitiveModel`1") ? rr_u64(model + 0x10) : 0;
+        float spread;
+        if (u_is(data, "FloatData") && rr_read(data + RR_OFF_PRIM_VALUE, &spread, sizeof(spread)) &&
+            isfinite(spread) && spread >= 0.0f && spread <= 1000.0f) {
+            out->spread_value = spread;
+            out->has_spread_data = 1;
+        }
+    }
+    uint64_t world = g_world, battle = g_battle;
+    if (!PL(world) || rr_u64(world) != g_k_world || !u_is(battle, "BattleEntitiesModel") ||
+        rr_u64(battle + RR_OFF_BATTLE_WORLD) != world) return;
+    uint64_t player = rr_u64(battle + RR_OFF_BATTLE_PLAYER);
+    if (!u_is(player, "PlayerEntityModel") || rr_u64(player + RR_OFF_PLAYER_SERVER) != character) return;
+    uint64_t client = rr_u64(player + RR_OFF_PLAYER_CLIENT);
+    uint64_t fake = u_is(client, "PlayerClientModel") ? rr_u64(client + RR_OFF_CLIENT_FAKE_SPREAD) : 0;
+    float components[3];
+    if (!u_is(fake, "PlayerFakeSpreadModel") ||
+        !rr_read(fake + RR_OFF_FAKE_SPREAD_VALUES, components, sizeof(components))) return;
+    for (int i = 0; i < 3; ++i)
+        if (!isfinite(components[i]) || fabsf(components[i]) > 1000.0f) return;
+    if (world != g_world || battle != g_battle || rr_u64(player + RR_OFF_PLAYER_SERVER) != character) return;
+    /* Actual layout is Spread, Air, Move: components[0] is not Air. */
+    if (!out->has_spread_data && components[0] >= 0.0f) {
+        out->spread_value = components[0];
+        out->has_spread_data = 1;
+    }
+    out->spread_move = components[2];
+    out->spread_air = components[1];
+    out->has_fake_spread_data = 1;
 }
 
